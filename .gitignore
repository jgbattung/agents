# Python bytecode caches (generated when skill scripts are imported/run)
__pycache__/
*.py[cod]

# Local agent workflow state (never committed)
.gsd/

# Claude app skill sync (auto-managed, lands here via the ~/.claude/skills symlink)
skills/synced/

# Impeccable engine binary (fetched by the launcher, verified via engine-checksums.txt)
skills/impeccable/scripts/bin/
